# ── Base de données ─────────────────────────────────────────────────────────
# Runtime applicatif : rôle stockflow_app, soumis à RLS. OBLIGATOIRE en prod —
# sans lui l'app retombe sur POSTGRES_URL (rôle postgres, BYPASSRLS) et RLS
# ne protège plus rien. Le mot de passe du rôle est défini hors-git
# (ALTER ROLE stockflow_app LOGIN PASSWORD '...').
APP_POSTGRES_URL=postgresql://stockflow_app.npdfobiadwtxbvpyxydr:[APP-ROLE-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Migrations & seeds uniquement (rôle postgres, propriétaire). Posé
# automatiquement par l'intégration Vercel <> Supabase.
# DATABASE_URL accepté en fallback (voir src/db/client.ts, scripts/migrate.ts).
POSTGRES_URL=postgresql://postgres.npdfobiadwtxbvpyxydr:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Auth JWT (RS256) ────────────────────────────────────────────────────────
# Clés PEM encodées en base64 (une seule ligne). Génération :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem  →  JWT_PRIVATE_KEY
#   base64 -w0 public.pem   →  JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=[BASE64-PEM]
JWT_PUBLIC_KEY=[BASE64-PEM]
