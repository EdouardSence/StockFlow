{
  "name": "stockflow",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "rm -rf dist && vite build && sh -c 'D=.vercel/output/static; [ -d \"$D\" ] || D=.output/public; cp dist/sw.js dist/workbox-*.js \"$D\"/'",
    "preview": "vite preview",
    "migrate": "bun run scripts/migrate.ts",
    "rapport": "bun run scripts/rapport-pdf.ts docs/rapport/rapport-bloc2.md docs/rapport/rapport-bloc2.pdf",
    "rapport:bloc4": "bun run scripts/rapport-pdf.ts docs/rapport/rapport-bloc4.md docs/rapport/rapport-bloc4.pdf",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "format": "biome format",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "prepare": "husky"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@sentry/react": "^10.52.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.65",
    "@tanstack/router-plugin": "^1.132.0",
    "effect": "^3.21.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "lucide-react": "^1.14.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260507-141654-d7a34477",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "^4.1.5",
    "axe-core": "^4.11.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "marked": "^18.0.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
